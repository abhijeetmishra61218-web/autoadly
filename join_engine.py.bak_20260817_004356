API_ID = 37701222
API_HASH = "5e137a9ed23be5787dcdd9a92d9e48df"

JOIN_DELAY = 25
ACCOUNT_DELAY = 15

def parse_identifier(raw: str):
    raw = raw.strip()
    if raw.startswith("https://t.me/addlist/") or raw.startswith("t.me/addlist/"):
        return ("chatlist", raw.split("addlist/", 1)[1].split("/")[0])
    if "t.me/+" in raw:
        h = raw.split("t.me/+", 1)[1].split("/")[0]
        return ("invite_hash", h)
    if "joinchat/" in raw:
        h = raw.split("joinchat/", 1)[1].split("/")[0]
        return ("invite_hash", h)
    if "t.me/c/" in raw:
        parts = raw.split("t.me/c/", 1)[1].split("/")
        chan = parts[0]
        if chan.isdigit():
            return ("unsupported", raw)
        return ("username", chan)
    if "t.me/" in raw:
        name = raw.split("t.me/", 1)[1].split("/")[0]
        return ("username", name)
    return ("username", raw.lstrip("@"))

async def join_one(client: TelegramClient, identifier: str):
    kind, value = parse_identifier(identifier)
    if kind == "unsupported":
        print(f"  SKIP (unsupported link format): {identifier}")
        return None
    try:
        if kind == "invite_hash":
            try:
                await client(ImportChatInviteRequest(value))
            except UserAlreadyParticipantError:
                pass
            entity = await client.get_entity(identifier)
        else:
            try:
                await client(JoinChannelRequest(value))
            except UserAlreadyParticipantError:
                pass
            entity = await client.get_entity(value)
        return entity
    except FloodWaitError as e:
        print(f"  FLOOD WAIT {e.seconds}s on {identifier}, skipping for now.")
        return None
    except (ChannelPrivateError, UsernameNotOccupiedError, InviteHashExpiredError) as e:
        print(f"  FAILED to join {identifier}: {e}")
        return None
    except Exception as e:
        print(f"  FAILED to join {identifier}: {e}")
        return None

async def register_marketplace(client: TelegramClient, entity, chat_username_hint: str):
    chat_id = utils.get_peer_id(entity)
    is_forum = bool(getattr(entity, "forum", False))
    username = getattr(entity, "username", None) or chat_username_hint

    marketplace_id = await db.upsert_marketplace(chat_id, username, is_forum)
    await db.add_marketplace_to_all_lists(marketplace_id, list_id=1)

    # NOTE: master-folder auto-sync disabled — it was spawning one full Telethon
    # connection PER marketplace (fire-and-forget, never closed), causing hundreds
    # of dangling connections to the master account. Use the manual batch-sync
    # script instead when you need to update the master folder.
    pass

    if is_forum:
        try:
            result = await client(GetForumTopicsRequest(
                peer=entity, offset_date=None, offset_id=0, offset_topic=0, limit=100
            ))
            saved = 0
            for topic in result.topics:
                if not hasattr(topic, "title"):
                    continue  # e.g. ForumTopicDeleted — not a real, postable topic
                closed = bool(getattr(topic, "closed", False))
                await db.upsert_forum_topic(marketplace_id, topic.title, topic.id, closed)
                saved += 1
            if saved == 0:
                print(f"  Note: {username} is a forum but had no valid (non-deleted) topics to save.")
        except Exception as e:
            print(f"  Could not fetch topics for {username}: {e}")

    return marketplace_id

async def run_join_batch(identifiers: list, progress_callback=None):
    accounts = await db.get_all_ad_accounts()
    if not accounts:
        msg = "No ad accounts exist yet — add at least one before joining marketplaces."
        print(msg)
        if progress_callback:
            await progress_callback(msg)
        return

    joined_count = 0
    newly_registered = []  # (entity, hint) — synced to master folder once at the end

    for i, account in enumerate(accounts):
        client = TelegramClient(StringSession(account["session_string"]), API_ID, API_HASH)
        await client.connect()

        consecutive_floodwaits = 0
        for identifier in identifiers:
            kind, value = parse_identifier(identifier)
            if kind == "chatlist":
                print(f"[{account['phone']}] joining chat folder {identifier} ...")
                chats = await join_chatlist(client, value)
                if i == 0:
                    for chat in chats:
                        entity = chat
                        username = getattr(entity, "username", None) or str(getattr(entity, "id", identifier))
                        await register_marketplace(client, entity, username)
                        newly_registered.append((entity, username))
                        joined_count += 1
                await delete_local_chatlist_folder(client, ad_account_id=account["id"])
                await asyncio.sleep(JOIN_DELAY)
                continue

            print(f"[{account['phone']}] joining {identifier} ...")
            entity = await join_one(client, identifier)
            if entity and i == 0:
                await register_marketplace(client, entity, identifier)
                newly_registered.append((entity, identifier))
                joined_count += 1
                consecutive_floodwaits = 0
            elif entity is None:
                consecutive_floodwaits += 1
                if consecutive_floodwaits >= 3:
                    print(f"[{account['phone']}] hit 3 flood-waits in a row, stopping this account's joins for now to avoid escalating the restriction.")
                    break
            await asyncio.sleep(JOIN_DELAY)

        await client.disconnect()
        await asyncio.sleep(ACCOUNT_DELAY)

    if newly_registered:
        await sync_entities_to_master_folder(newly_registered)

    summary = f"Done. Registered {joined_count} marketplace(s), processed across {len(accounts)} ad account(s)."
    print(summary)
    if progress_callback:
        await progress_callback(summary)


async def join_chatlist(client, slug: str):
    """Joins every chat in a shared Chat Folder link (t.me/addlist/<slug>) in one call.
       Returns the list of newly joined entities (peers)."""
    try:
        result = await client(CheckChatlistInviteRequest(slug=slug))
        # CheckChatlistInviteRequest returns chats already resolved as full chat objects in most cases
        already_joined_ids = set()
        if hasattr(result, "already_peer_ids"):
            already_joined_ids = set(p for p in result.already_peer_ids)

        to_join_peers = []
        for chat in getattr(result, "chats", []):
            peer_id = utils.get_peer_id(chat)
            if peer_id not in already_joined_ids:
                to_join_peers.append(await client.get_input_entity(chat))

        if to_join_peers:
            try:
                await client(JoinChatlistInviteRequest(slug=slug, peers=to_join_peers))
            except Exception as e:
                print(f"  Note: JoinChatlistInviteRequest failed ({e}), but proceeding to register already-joined chats.")
        else:
            print("  Already a member of every chat in this folder — nothing new to join, just registering them.")

        return getattr(result, "chats", [])
    except FloodWaitError as e:
        print(f"  FLOOD WAIT {e.seconds}s on chatlist join, skipping for now.")
        return []
    except Exception as e:
        print(f"  FAILED to join chatlist {slug}: {e}")
        return []

async def run_join_batch_single_account(ad_account_id: int, identifiers: list, list_id: int):
    """Like run_join_batch, but joins with exactly one ad account and adds results to a specific list_id
       (used for a single customer's 'Add Custom Marketplaces' feature, not the global marketplace pool)."""
    account = await db.get_ad_account_by_id(ad_account_id)
    if not account:
        return
    client = TelegramClient(StringSession(account["session_string"]), API_ID, API_HASH)
    await client.connect()

    for identifier in identifiers:
        kind, value = parse_identifier(identifier)
        if kind == "chatlist":
            chats = await join_chatlist(client, value)
            for chat in chats:
                username = getattr(chat, "username", None) or str(getattr(chat, "id", identifier))
                marketplace_id = await register_marketplace(client, chat, username)
                await db.add_marketplace_to_all_lists(marketplace_id, list_id=list_id)
            await delete_local_chatlist_folder(client, ad_account_id=account["id"])
            continue
        entity = await join_one(client, identifier)
        if entity:
            marketplace_id = await register_marketplace(client, entity, identifier)
            await db.add_marketplace_to_all_lists(marketplace_id, list_id=list_id)
        await asyncio.sleep(JOIN_DELAY)

    await client.disconnect()

async def run_join_batch_for_specific_account(ad_account_id: int, identifiers: list):
    """Joins one specific ad account to marketplaces. Each identifier can be a username,
       invite link, or a chat-folder link (t.me/addlist/...) — handled automatically."""
    account = await db.get_ad_account_by_id(ad_account_id)
    if not account:
        return
    client = TelegramClient(StringSession(account["session_string"]), API_ID, API_HASH)
    await client.connect()

    consecutive_floodwaits = 0
    for identifier in identifiers:
        kind, value = parse_identifier(identifier)
        if kind == "chatlist":
            print(f"[{account['phone']}] joining chat folder {identifier} ...")
            chats = await join_chatlist(client, value)
            for chat in chats:
                username = getattr(chat, "username", None) or str(getattr(chat, "id", identifier))
                await register_marketplace(client, chat, username)
            await delete_local_chatlist_folder(client, ad_account_id=account["id"])
            await asyncio.sleep(JOIN_DELAY)
            continue

        entity = await join_one(client, identifier)
        if entity is None:
            consecutive_floodwaits += 1
            if consecutive_floodwaits >= 3:
                print(f"[{account['phone']}] hit 3 flood-waits catching up on marketplaces, stopping for now.")
                break
        else:
            consecutive_floodwaits = 0
        await asyncio.sleep(JOIN_DELAY)

    await client.disconnect()


async def delete_local_chatlist_folder(client, folder_title_hint=None, ad_account_id=None):
    if not folder_title_hint:
        return  # never delete blindly — without a real title to match, we don't know which folder is safe to remove
    """Deletes any local folder on this account that was created by joining a
       shared chat-folder link (identified by title, since the join API doesn't
       tag which folder resulted from which join). NEVER runs on the master
       account, since that account's folder IS the shared invite source — deleting
       it would kill the invite link for every future account."""
    if ad_account_id is not None:
        import content_store as _store
        if ad_account_id == _store.get_master_account_id():
            print(f"  Skipping folder cleanup — account {ad_account_id} is the master account (owns the shared invite).")
            return
    try:
        from telethon.tl.functions.messages import GetDialogFiltersRequest, UpdateDialogFilterRequest
        result = await client(GetDialogFiltersRequest())
        filters = getattr(result, "filters", result)
        deleted = 0
        for f in filters:
            title_obj = getattr(f, "title", None)
            title_text = getattr(title_obj, "text", None) if title_obj else None
            fid = getattr(f, "id", None)
            if fid is None or fid == 0:
                continue  # 0 is the reserved "All Chats" filter, never touch it
            if folder_title_hint and title_text and folder_title_hint.lower() not in title_text.lower():
                continue
            await client(UpdateDialogFilterRequest(id=fid, filter=None))
            deleted += 1
        if deleted:
            print(f"  Deleted {deleted} local folder(s) matching '{folder_title_hint}'.")
    except Exception as e:
        print(f"[join_engine] Could not clean up local chat folder: {e}")

async def sync_new_marketplace_to_master_folder(entity, chat_username_hint):
    """Whenever ANY marketplace is newly registered anywhere in the system,
       make sure the master account is also a member, and add it into the
       master account's folder so the one shareable link always includes it
       for future accounts joining fresh."""
    import content_store as store
    master_id = store.get_master_account_id()
    if not master_id:
        return

    try:
        master_account = await db.get_ad_account_by_id(master_id)
        if not master_account:
            return
        master_client = TelegramClient(StringSession(master_account["session_string"]), API_ID, API_HASH)
        await master_client.connect()

        # Join master to this chat if not already a member
        try:
            await master_client.get_entity(entity)
        except Exception:
            pass
        try:
            from telethon.tl.functions.channels import JoinChannelRequest
            await master_client(JoinChannelRequest(entity))
        except Exception:
            pass  # already a member, or not joinable this way — fine either way

        # Add it into the master's folder (the one used for the shareable link)
        from telethon.tl.functions.messages import GetDialogFiltersRequest, UpdateDialogFilterRequest
        result = await master_client(GetDialogFiltersRequest())
        filters = getattr(result, "filters", result)
        folder_link = store.get_marketplace_folder_link()
        target_slug = folder_link.split("addlist/", 1)[1].split("/")[0] if folder_link else None

        for f in filters:
            fid = getattr(f, "id", None)
            if fid is None or fid == 0:
                continue
            include_peers = getattr(f, "include_peers", None)
            if include_peers is None:
                continue
            input_entity = await master_client.get_input_entity(entity)
            already_included = any(
                getattr(p, "channel_id", None) == getattr(input_entity, "channel_id", None)
                for p in include_peers
            )
            if not already_included:
                include_peers.append(input_entity)
                f.include_peers = include_peers
                await master_client(UpdateDialogFilterRequest(id=fid, filter=f))
                print(f"  Added {chat_username_hint} to master account's shared folder.")
            break  # only touch the first real custom folder found

        await master_client.disconnect()
    except Exception as e:
        print(f"[join_engine] Could not sync new marketplace to master folder: {e}")

async def sync_entities_to_master_folder(entities_with_hints):
    """Batched, connection-safe version: joins the master account to every given
       entity (if needed) and adds them ALL to its folder in ONE API update,
       reusing engine's cached client (no dangling connections)."""
    if not entities_with_hints:
        return
    import content_store as store
    import engine
    master_id = store.get_master_account_id()
    if not master_id:
        return
    try:
        master_client = await engine.get_client(master_id)
    except Exception as e:
        print(f"[join_engine] could not get master client: {e}")
        return

    from telethon.tl.functions.channels import JoinChannelRequest
    from telethon.tl.functions.messages import GetDialogFiltersRequest, UpdateDialogFilterRequest

    joined_input_entities = []
    for entity, hint in entities_with_hints:
        try:
            await master_client(JoinChannelRequest(entity))
        except Exception:
            pass  # already a member, or not joinable this way — fine either way
        try:
            input_entity = await master_client.get_input_entity(entity)
            joined_input_entities.append((input_entity, hint))
        except Exception as e:
            print(f"  [master sync] could not resolve {hint}: {e}")

    if not joined_input_entities:
        return

    try:
        result = await master_client(GetDialogFiltersRequest())
        filters = getattr(result, "filters", result)
        target_filter = None
        for f in filters:
            fid = getattr(f, "id", None)
            if fid and fid != 0 and getattr(f, "include_peers", None) is not None:
                target_filter = f
                break
        if target_filter is None:
            print("[join_engine] No custom folder found on master account to sync into.")
            return

        existing_ids = {getattr(p, "channel_id", None) for p in target_filter.include_peers}
        added = 0
        for input_entity, hint in joined_input_entities:
            cid = getattr(input_entity, "channel_id", None)
            if cid in existing_ids:
                continue
            target_filter.include_peers.append(input_entity)
            existing_ids.add(cid)
            added += 1

        if added:
            await master_client(UpdateDialogFilterRequest(id=target_filter.id, filter=target_filter))
            print(f"[join_engine] Added {added} new marketplace(s) to master folder.")
    except Exception as e:
        print(f"[join_engine] master folder update failed: {e}")

async def remove_entity_from_master_folder(entity):
    """Removes one specific chat from the master account's folder (so future
       shared-link joins skip it) — does NOT delete the whole folder."""
    import content_store as store
    import engine
    master_id = store.get_master_account_id()
    if not master_id:
        return False
    try:
        master_client = await engine.get_client(master_id)
        from telethon.tl.functions.messages import GetDialogFiltersRequest, UpdateDialogFilterRequest
        result = await master_client(GetDialogFiltersRequest())
        filters = getattr(result, "filters", result)
        target_filter = None
        for f in filters:
            fid = getattr(f, "id", None)
            if fid and fid != 0 and getattr(f, "include_peers", None) is not None:
                target_filter = f
                break
        if target_filter is None:
            return False
        input_entity = await master_client.get_input_entity(entity)
        target_cid = getattr(input_entity, "channel_id", None)
        before = len(target_filter.include_peers)
        target_filter.include_peers = [p for p in target_filter.include_peers if getattr(p, "channel_id", None) != target_cid]
        if len(target_filter.include_peers) < before:
            await master_client(UpdateDialogFilterRequest(id=target_filter.id, filter=target_filter))
            return True
        return False
    except Exception as e:
        print(f"[join_engine] remove_entity_from_master_folder failed: {e}")
        return False
